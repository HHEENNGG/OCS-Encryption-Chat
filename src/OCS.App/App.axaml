<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OCS.App.App"
             xmlns:Fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             xmlns:vm="using:OCS.App.ViewModels"
             xmlns:views="using:OCS.App.Views"
             xmlns:conv="using:OCS.App.Infrastructure"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <conv:OutgoingBrushConverter x:Key="OutBrush"/>
    <conv:OutgoingAlignmentConverter x:Key="OutAlign"/>
    <conv:TrustBrushConverter x:Key="TrustBrush"/>
    <conv:InverseBoolConverter x:Key="InverseBool"/>
    <conv:MonitoringLabelConverter x:Key="MonitoringLabel"/>
    <conv:TrustStateLabelConverter x:Key="TrustStateLabel"/>
    <conv:TrustStateBrushConverter x:Key="TrustStateBrush"/>
  </Application.Resources>
  <Application.Styles>
    <Fluent:FluentTheme />
  </Application.Styles>
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:UnlockViewModel}">
      <views:UnlockView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChatViewModel}">
      <views:ChatView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ContactsViewModel}">
      <views:ContactsView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:KeysViewModel}">
      <views:KeysView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SecurityViewModel}">
      <views:SecurityView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView/>
    </DataTemplate>
  </Application.DataTemplates>
</Application>
