<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OCS.App.Views.ContactsView">
  <Grid ColumnDefinitions="*,380">
    <DockPanel Grid.Column="0" Margin="12">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <TextBlock Text="联系人" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="8,4" FontSize="12"/>
      </StackPanel>
      <ListBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="3" Margin="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TrustState, Converter={StaticResource TrustStateLabel}}"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="{Binding TrustState, Converter={StaticResource TrustStateBrush}}"/>
              </StackPanel>
              <TextBlock Text="{Binding IdentityFingerprint}" FontSize="10"
                         Foreground="#9aa0a6" TextWrapping="Wrap" FontFamily="Consolas"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Border Grid.Column="1" Background="#1a1a1e" BorderBrush="#2c2c30" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="14" Spacing="10">
          <TextBlock Text="导入对方公钥包" FontWeight="Bold"/>
          <TextBlock Text="让对方在「密钥管理」导出公钥包,粘贴到下方或从文件导入。导入时会验证格式、签名、版本与有效期;导入后为「未验证」,必须带外比对指纹。"
                     TextWrapping="Wrap" FontSize="11" Foreground="#9aa0a6"/>
          <TextBox Watermark="联系人显示名" Text="{Binding ImportName}"/>
          <TextBox Watermark="粘贴公钥包 JSON…" Text="{Binding ImportBundleText}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="180"
                   FontFamily="Consolas" FontSize="11"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="导入" Command="{Binding ImportCommand}" Classes="accent" Padding="12,6"/>
            <Button Content="从文件导入…" Command="{Binding ImportFileCommand}" Padding="12,6"/>
          </StackPanel>
          <Separator Margin="0,6"/>
          <TextBlock Text="带外验证指纹" FontWeight="Bold"/>
          <TextBlock Text="通过电话/见面等独立信道核对所选联系人的指纹(上方列表),完全一致后粘贴到下方并确认。指纹不匹配绝不会被标记为已验证。"
                     TextWrapping="Wrap" FontSize="11" Foreground="#9aa0a6"/>
          <TextBox Watermark="带外确认的指纹" Text="{Binding VerifyFingerprint}"
                   FontFamily="Consolas" FontSize="11"/>
          <Button Content="标记为已验证" Command="{Binding VerifyCommand}" Padding="12,6"/>
          <Separator Margin="0,6"/>
          <TextBlock Text="我的公钥包" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="复制到剪贴板" Command="{Binding ExportMyBundleCommand}" Padding="12,6"/>
            <Button Content="保存到文件…" Command="{Binding SaveMyBundleCommand}" Padding="12,6"/>
          </StackPanel>
          <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#9aa0a6" FontSize="12"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
